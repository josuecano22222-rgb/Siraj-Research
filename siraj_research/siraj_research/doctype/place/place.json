{
 "doctype": "DocType",
 "name": "Place",
 "module": "Siraj Research",
 "custom": 0,
 "engine": "InnoDB",
 "field_order": [
  "tab_identity",
  "sb_identity",
  "naming_series",
  "display_name",
  "cb_identity",
  "name_ar",
  "name_en",
  "name_original",
  "name_original_lang",
  "cb_hierarchy",
  "is_group",
  "parent_place",
  "place_type",
  "tab_administration",
  "sb_admin",
  "country",
  "governorate",
  "cb_admin",
  "district",
  "municipality",
  "village",
  "community",
  "locality_as_stated",
  "image",
  "image_url",
  "image_alt",
  "tab_evidence",
  "sb_geo",
  "latitude",
  "longitude",
  "geo_precision",
  "geocoding_method",
  "geo_uncertainty_m",
  "geometry_source",
  "geo_description",
  "sb_research",
  "research_significance",
  "tab_provenance",
  "sb_evidence",
  "primary_source",
  "documentation_level",
  "authentication_level",
  "cb_provenance",
  "workflow_state",
  "researcher_notes",
  "sb_evidence_table",
  "evidence",
  "sb_identifiers",
  "external_identifiers"
 ],
 "fields": [
  {
   "fieldname": "tab_identity",
   "fieldtype": "Tab Break",
   "label": "Identity"
  },
  {
   "fieldname": "sb_identity",
   "fieldtype": "Section Break",
   "label": ""
  },
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "PLC-.####\nPLC-.YY.-.####",
   "reqd": 1,
   "default": "PLC-.####"
  },
  {
   "fieldname": "display_name",
   "fieldtype": "Data",
   "label": "Display name",
   "read_only": 1,
   "in_list_view": 1,
   "search_index": 1,
   "in_global_search": 1,
   "length": 140,
   "in_preview": 1
  },
  {
   "fieldname": "cb_identity",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "name_ar",
   "fieldtype": "Data",
   "label": "Name (Arabic)",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "in_global_search": 1,
   "length": 140,
   "in_preview": 1,
   "allow_in_quick_entry": 1
  },
  {
   "fieldname": "name_en",
   "fieldtype": "Data",
   "label": "Name (English)",
   "in_list_view": 1,
   "search_index": 1,
   "in_global_search": 1,
   "length": 140,
   "in_preview": 1,
   "allow_in_quick_entry": 1
  },
  {
   "fieldname": "name_original",
   "fieldtype": "Data",
   "label": "Name (original language)",
   "length": 140
  },
  {
   "fieldname": "name_original_lang",
   "fieldtype": "Link",
   "label": "Original-name language",
   "options": "Language"
  },
  {
   "fieldname": "cb_hierarchy",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "is_group",
   "fieldtype": "Check",
   "label": "Is group",
   "default": "0",
   "description": "Nested-set grouping node (a country or governorate that contains other places). Frappe's standard tree flag."
  },
  {
   "fieldname": "parent_place",
   "fieldtype": "Link",
   "label": "Part of (parent place)",
   "options": "Place",
   "description": "Builds the geographic hierarchy: country → governorate → city → quarter. Cycles are rejected by the NestedSet.",
   "link_filters": "[[\"Place\", \"name\", \"!=\", \"eval:doc.name\"]]"
  },
  {
   "fieldname": "place_type",
   "fieldtype": "Link",
   "label": "Place type",
   "options": "Place Type",
   "reqd": 1,
   "in_standard_filter": 1,
   "in_preview": 1,
   "allow_in_quick_entry": 1
  },
  {
   "fieldname": "tab_administration",
   "fieldtype": "Tab Break",
   "label": "Administration"
  },
  {
   "fieldname": "sb_admin",
   "fieldtype": "Section Break",
   "label": "Administrative units"
  },
  {
   "fieldname": "country",
   "fieldtype": "Link",
   "label": "Country",
   "options": "Country",
   "in_standard_filter": 1,
   "remember_last_selected_value": 1,
   "in_preview": 1,
   "allow_in_quick_entry": 1
  },
  {
   "fieldname": "governorate",
   "fieldtype": "Link",
   "label": "Governorate",
   "options": "Governorate",
   "description": "Only governorates of the chosen country are offered.",
   "remember_last_selected_value": 1,
   "in_preview": 1,
   "allow_in_quick_entry": 1,
   "link_filters": "[[\"Governorate\", \"country\", \"=\", \"eval:doc.country\"]]"
  },
  {
   "fieldname": "cb_admin",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "district",
   "fieldtype": "Link",
   "label": "District / region",
   "options": "District",
   "description": "Third level of the six-level chain. Only districts of the chosen governorate are offered.",
   "link_filters": "[[\"District\", \"governorate\", \"=\", \"eval:doc.governorate\"]]"
  },
  {
   "fieldname": "municipality",
   "fieldtype": "Link",
   "label": "Municipality",
   "options": "Municipality",
   "description": "Third level of the administrative chain (country → governorate → district → municipality → village → community); only municipalities of the chosen district are offered.",
   "link_filters": "[[\"Municipality\", \"district\", \"=\", \"eval:doc.district\"]]"
  },
  {
   "fieldname": "village",
   "fieldtype": "Link",
   "label": "Neighbourhood / village",
   "options": "Village",
   "description": "Fourth level: only villages of the chosen municipality.",
   "link_filters": "[[\"Village\", \"municipality\", \"=\", \"eval:doc.municipality\"]]"
  },
  {
   "fieldname": "community",
   "fieldtype": "Link",
   "label": "Community / cluster",
   "options": "Community",
   "description": "Fifth level: only communities of the chosen village.",
   "link_filters": "[[\"Community\", \"village\", \"=\", \"eval:doc.village\"]]"
  },
  {
   "fieldname": "locality_as_stated",
   "fieldtype": "Data",
   "label": "Locality (as stated)",
   "length": 140,
   "description": "Free-text locality from an older import that could not be matched to a Governorate or District. Nothing is guessed."
  },
  {
   "fieldname": "image",
   "fieldtype": "Attach Image",
   "label": "Image",
   "in_preview": 1
  },
  {
   "fieldname": "image_url",
   "fieldtype": "Data",
   "label": "Image URL (external)",
   "options": "URL"
  },
  {
   "fieldname": "image_alt",
   "fieldtype": "Data",
   "label": "Image alt text",
   "length": 140
  },
  {
   "fieldname": "tab_evidence",
   "fieldtype": "Tab Break",
   "label": "Position & evidence"
  },
  {
   "fieldname": "sb_geo",
   "fieldtype": "Section Break",
   "label": "Position (this record's own)",
   "collapsible": 1,
   "collapsible_depends_on": "eval:doc.latitude && doc.longitude"
  },
  {
   "fieldname": "latitude",
   "fieldtype": "Float",
   "label": "Latitude",
   "precision": "6",
   "description": "This record's own latitude, independent of any linked place.",
   "in_standard_filter": 0,
   "in_preview": 1
  },
  {
   "fieldname": "longitude",
   "fieldtype": "Float",
   "label": "Longitude",
   "precision": "6",
   "description": "This record's own longitude, independent of any linked place.",
   "in_preview": 1
  },
  {
   "fieldname": "geo_precision",
   "fieldtype": "Select",
   "label": "Coordinate precision",
   "options": "exact\napproximate\ncentroid\nuncertain",
   "description": "How close the point is to the true position.",
   "depends_on": "eval:doc.latitude && doc.longitude"
  },
  {
   "fieldname": "geocoding_method",
   "fieldtype": "Select",
   "label": "How the point was obtained",
   "options": "manual\nmap_pick\ncoordinate_entry\ngazetteer\nadministrative\ncity_centroid\ngeocoder\nhistorical_map\ninherited",
   "description": "A city centroid is not a street address; recording the method stops a centroid from being read as a verified location.",
   "depends_on": "eval:doc.latitude && doc.longitude"
  },
  {
   "fieldname": "geo_uncertainty_m",
   "fieldtype": "Float",
   "label": "Uncertainty radius (m)",
   "precision": "1",
   "description": "The radius the true position could lie within.",
   "depends_on": "eval:doc.latitude && doc.longitude"
  },
  {
   "fieldname": "geometry_source",
   "fieldtype": "Data",
   "label": "Point source",
   "length": 140,
   "description": "The map, survey or gazetteer the coordinates came from.",
   "depends_on": "eval:doc.latitude && doc.longitude"
  },
  {
   "fieldname": "geo_description",
   "fieldtype": "Text Editor",
   "label": "Geographic description",
   "collapsible": 1,
   "description": "How the place sits in the landscape, its boundaries, and what is near it."
  },
  {
   "fieldname": "sb_research",
   "fieldtype": "Section Break",
   "label": "Research"
  },
  {
   "fieldname": "research_significance",
   "fieldtype": "Text Editor",
   "label": "Research significance"
  },
  {
   "fieldname": "tab_provenance",
   "fieldtype": "Tab Break",
   "label": "Provenance & State"
  },
  {
   "fieldname": "sb_evidence",
   "fieldtype": "Section Break",
   "label": "Source & verification"
  },
  {
   "fieldname": "primary_source",
   "fieldtype": "Link",
   "label": "Primary source",
   "options": "Source",
   "description": "The source the record rests on. Additional claims from other sources are recorded in the Evidence table, one claim per row."
  },
  {
   "fieldname": "documentation_level",
   "fieldtype": "Link",
   "label": "Documentation level",
   "options": "Documentation Level"
  },
  {
   "fieldname": "authentication_level",
   "fieldtype": "Link",
   "label": "Authentication level",
   "options": "Authentication Level",
   "description": "How strongly the record's content is verified."
  },
  {
   "fieldname": "cb_provenance",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "workflow_state",
   "fieldtype": "Link",
   "label": "Record status",
   "options": "Workflow State",
   "default": "Draft",
   "read_only": 1,
   "in_standard_filter": 1,
   "search_index": 1,
   "no_copy": 1,
   "description": "Editorial state, driven by the SIRAJ Review workflow (Draft → In Review → Verified → Published, plus Needs Update / Disputed / Archived / Rejected)."
  },
  {
   "fieldname": "researcher_notes",
   "fieldtype": "Text",
   "label": "Researcher's notes",
   "permlevel": 1,
   "description": "Internal working notes. At permission level 1, so visible to reviewers and administrators only; discussion belongs in the document's comment thread instead."
  },
  {
   "fieldname": "sb_evidence_table",
   "fieldtype": "Section Break",
   "label": "Evidence (claims this record makes)"
  },
  {
   "fieldname": "evidence",
   "fieldtype": "Table",
   "label": "Evidence",
   "options": "Evidence",
   "no_copy": 1,
   "columns": 9,
   "description": "One row per claim: which source says what, where in the source, whether it supports or contradicts, and who verified it. Not copied with the record: a claim is evidence about one specific record."
  },
  {
   "fieldname": "sb_identifiers",
   "fieldtype": "Section Break",
   "label": "External identifiers"
  },
  {
   "fieldname": "external_identifiers",
   "fieldtype": "Table",
   "label": "External identifiers",
   "options": "External Identifier",
   "no_copy": 1,
   "columns": 8,
   "description": "VIAF, Wikidata, ORCID, library catalogue or legacy numbers, kept out of the record's own identifier. Never copied: an authority identifier belongs to exactly one record."
  }
 ],
 "permissions": [
  {
   "role": "SIRAJ Viewer",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "report": 1,
