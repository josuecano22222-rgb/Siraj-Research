  }
 ],
 "links": [
  {
   "link_doctype": "Institution",
   "link_fieldname": "place",
   "group": "Institution"
  },
  {
   "link_doctype": "Person",
   "link_fieldname": "birthplace",
   "group": "Person"
  },
  {
   "link_doctype": "Event",
   "link_fieldname": "place",
   "group": "Event"
  },
  {
   "link_doctype": "Place",
   "link_fieldname": "parent_place",
