  }
 ],
 "actions": [
  {
   "label": "Find duplicates",
   "group": "Data quality",
   "action_type": "Server Action",
   "action": "siraj.api.duplicate_candidates_for_doc",
   "hidden": 0,
   "custom": 0
  },
  {
   "label": "Open on the map",
   "group": "Geography",
   "action_type": "Server Action",
   "action": "siraj.api.open_on_map",
   "hidden": 0,
   "custom": 0
  },
  {
   "label": "Merge a duplicate into this record",
   "group": "Data quality",
   "action_type": "Server Action",
   "action": "siraj.api.merge_duplicate_into",
   "hidden": 0,
   "custom": 0
  }
 ],
 "states": [
  {
   "title": "Draft",
   "color": "Gray"
  },
  {
   "title": "In Review",
   "color": "Orange"
  },
  {
   "title": "Verified",
   "color": "Light Blue"
  },
  {
   "title": "Published",
   "color": "Green"
  },
  {
   "title": "Needs Update",
   "color": "Yellow"
  },
  {
   "title": "Disputed",
   "color": "Red"
  },
  {
   "title": "Archived",
   "color": "Purple"
  },
  {
   "title": "Rejected",
   "color": "Red"
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "row_format": "Dynamic",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "is_tree": 1,
 "editable_grid": 1,
 "track_changes": 1,
 "track_seen": 1,
 "track_views": 1,
 "quick_entry": 1,
 "allow_rename": 1,
 "allow_import": 1,
 "show_title_field_in_link": 1,
 "show_preview_popup": 1,
 "allow_copy": 1,
 "allow_events_in_timeline": 1,
 "in_create": 1,
 "nsm_parent_field": "parent_place",
 "title_field": "display_name",
 "image_field": "image",
 "search_fields": "display_name,name_ar,name_en,name_original",
 "default_view": "Tree",
 "icon": "map-pin",
 "description": "Cities, districts, sites and buildings of research interest.",
 "default_print_format": "SIRAJ Research Dossier"
}
