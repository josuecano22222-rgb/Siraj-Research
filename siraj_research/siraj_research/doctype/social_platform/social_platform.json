{
 "doctype": "DocType",
 "name": "Social Platform",
 "module": "Siraj Research",
 "custom": 0,
 "engine": "InnoDB",
 "field_order": [
  "code",
  "label_en",
  "label_ar",
  "description_en",
  "description_ar",
  "color",
  "icon",
  "sort_order",
  "disabled",
  "is_system",
  "sb_resolution",
  "base_url"
 ],
 "fields": [
  {
   "fieldname": "code",
   "fieldtype": "Data",
   "label": "Code",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "search_index": 1,
   "length": 64,
   "set_only_once": 1,
   "description": "Stable machine code used by data imports, report filters and the migration. Values are never reused."
  },
  {
   "fieldname": "label_en",
   "fieldtype": "Data",
   "label": "English label",
   "reqd": 0,
   "in_list_view": 1,
   "search_index": 1,
   "in_global_search": 1,
   "length": 140,
   "description": "The label shown in English lists, filters and exports."
  },
  {
   "fieldname": "label_ar",
   "fieldtype": "Data",
   "label": "Arabic label",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1,
   "in_global_search": 1,
   "length": 140,
   "description": "The Arabic label printed in Arabic exports and reports."
  },
  {
   "fieldname": "description_en",
   "fieldtype": "Small Text",
   "label": "Description (EN)"
  },
  {
   "fieldname": "description_ar",
   "fieldtype": "Small Text",
   "label": "Description (AR)"
  },
  {
   "fieldname": "color",
   "fieldtype": "Color",
   "label": "Colour",
   "description": "Badge colour used on cards, list indicators and reports."
  },
  {
   "fieldname": "icon",
   "fieldtype": "Icon",
   "label": "Icon",
   "description": "Frappe icon name (e.g. 'building', 'map-pin')."
  },
  {
   "fieldname": "sort_order",
   "fieldtype": "Int",
   "label": "Sort order",
   "default": "100",
   "in_list_view": 1,
   "description": "Position within its own list; lower comes first."
  },
  {
   "fieldname": "disabled",
   "fieldtype": "Check",
   "label": "Disabled",
   "description": "Disabled values stay on existing records but are not offered for new ones."
  },
  {
   "fieldname": "is_system",
   "fieldtype": "Check",
   "label": "System value",
   "read_only": 1,
   "default": "0",
   "description": "Seeded by the application; cannot be renamed or deleted."
  },
  {
   "fieldname": "sb_resolution",
   "fieldtype": "Section Break",
   "label": "Resolution"
  },
  {
   "fieldname": "base_url",
   "fieldtype": "Data",
   "label": "Profile URL prefix",
   "length": 140,
   "description": "e.g. https://x.com/ — prepended to a handle to build a link."
  }
 ],
 "permissions": [
  {
   "role": "SIRAJ Viewer",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 0,
   "share": 0,
   "select": 1,
   "import": 0
  },
  {
   "role": "SIRAJ Researcher",
   "read": 1,
   "write": 0,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1,
   "select": 1,
   "import": 0
  },
  {
   "role": "SIRAJ Reviewer",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1,
   "select": 1,
   "import": 1
  },
  {
   "role": "SIRAJ Administrator",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1,
   "select": 1,
   "import": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1,
   "select": 1,
   "import": 1
  }
 ],
 "links": [
  {
   "link_doctype": "Social Account",
   "link_fieldname": "platform",
   "group": "Accounts on this platform",
   "is_child_table": 1,
   "parent_doctype": "Person",
   "table_fieldname": "social_accounts"
  },
  {
   "link_doctype": "Social Account",
   "link_fieldname": "platform",
   "group": "Accounts on this platform",
   "is_child_table": 1,
   "parent_doctype": "Institution",
   "table_fieldname": "social_accounts"
  }
 ],
 "actions": [],
 "states": [],
 "sort_field": "sort_order",
 "sort_order": "ASC",
 "row_format": "Dynamic",
 "autoname": "field:code",
 "naming_rule": "By fieldname",
 "editable_grid": 1,
 "quick_entry": 1,
 "allow_import": 1,
 "show_title_field_in_link": 1,
 "in_create": 1,
 "title_field": "label_en",
 "search_fields": "label_en,label_ar,code",
 "default_view": "List",
 "icon": "at-sign",
 "description": "The platforms a person or institution publishes on (SIRAJ stored these as one free-text field). A small governed list keeps the links clickable and reportable."
}
