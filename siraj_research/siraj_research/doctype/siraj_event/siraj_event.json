  {
   "fieldname": "latitude",
   "fieldtype": "Float",
   "label": "Latitude"
  },
  {
   "fieldname": "longitude",
   "fieldtype": "Float",
   "label": "Longitude"
  },
  {
   "fieldname": "geo_point",
   "label": "Map (point)",
   "fieldtype": "Geolocation",
   "insert_after": "longitude",
   "description": "Select a point on the map. It is mirrored into the latitude and longitude fields and resolves the administrative hierarchy."
  },
  {
   "fieldname": "coordinate_origin_confirmed",
   "label": "0,0 is an actual point",
   "fieldtype": "Check",
   "default": "0",
   "insert_after": "longitude",
   "description": "Tick only when latitude 0 and longitude 0 are a deliberate real location; otherwise the zero pair is treated as unset."
  },
  {
   "fieldname": "geo_precision",
   "fieldtype": "Select",
   "label": "Coordinate precision",
   "options": "exact\napproximate\ncentroid\nuncertain"
  },
  {
   "fieldname": "geocoding_method",
   "fieldtype": "Select",
   "label": "How the point was obtained",
   "options": "manual\nmap_pick\ncoordinate_entry\ngazetteer\nadministrative\ncity_centroid\ngeocoder\nhistorical_map\ninherited"
  },
  {
   "fieldname": "geo_uncertainty_m",
   "fieldtype": "Float",
   "label": "Uncertainty radius (m)"
  },
  {
   "fieldname": "geometry_source",
   "fieldtype": "Data",
   "label": "Point source"
  },
  {
   "fieldname": "country",
