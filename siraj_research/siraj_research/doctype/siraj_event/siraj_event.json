   "label": "Event type",
   "options": "Event Type"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "\nPlanned\nOngoing\nConcluded\nCancelled"
  },
  {
   "fieldname": "description",
   "fieldtype": "Text Editor",
   "label": "Description"
  },
  {
