   "fieldname": "role_as_stated",
   "fieldtype": "Data",
   "label": "Role / title (as stated)",
   "length": 140,
   "description": "'Professor of History', 'Chairman' \u2014 the wording the source uses for this connection."
  },
  {
   "fieldname": "tab_evidence",
   "fieldtype": "Tab Break",
   "label": "Evidence & review"
  },
  {
