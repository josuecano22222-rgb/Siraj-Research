   "options": "Relationship Type",
   "reqd": 1,
   "in_standard_filter": 1,
   "search_index": 1,
   "in_preview": 1,
   "allow_in_quick_entry": 1
  },
  {
   "fieldname": "direction",
   "fieldtype": "Select",
   "label": "Direction",
   "options": "Directed\nSymmetric",
   "read_only": 1,
   "description": "Taken from the Relationship Type: a symmetric type is stored once and read from both ends; it is never duplicated as a mirror row."
  },
  {
   "fieldname": "is_current",
   "fieldtype": "Check",
   "label": "Ongoing",
   "default": "0",
   "description": "True while the relationship still holds (no end date)."
