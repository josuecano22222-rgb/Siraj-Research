 "fields": [
  {
   "fieldname": "tab_mission",
   "fieldtype": "Tab Break",
   "label": "Mission"
  },
  {
   "fieldname": "sb_identity",
   "fieldtype": "Section Break",
   "label": "Identity"
  },
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "MIL-MIS-.YYYY-.####\nMIL-MIS-.####",
   "default": "MIL-MIS-.YYYY-.####",
   "reqd": 1
  },
  {
   "fieldname": "mission_name",
   "fieldtype": "Data",
   "label": "Mission name",
   "reqd": 1,
   "in_list_view": 1,
   "in_global_search": 1,
   "length": 140
  },
  {
   "fieldname": "unit",
   "fieldtype": "Link",
   "label": "Unit",
   "options": "Military Unit",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "cb_mission_type",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "mission_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Combat\nReconnaissance\nLogistics\nTraining\nHumanitarian\nPeacekeeping",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "deployment",
   "fieldtype": "Link",
   "label": "Deployment",
   "options": "Operational Deployment",
   "in_list_view": 1,
   "link_filters": "[[\"Operational Deployment\", \"unit\", \"=\", \"eval:doc.unit\"]]",
   "description": "A mission's deployment must belong to the mission's own unit or to an ancestor formation (`rules.check_mission`) — the filter expresses the same-unit case, the controller the ancestor case."
  },
  {
   "fieldname": "sb_mission_dates",
   "fieldtype": "Section Break",
   "label": "Dates & state"
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Start date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "End date"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Planned\nOngoing\nExecuted\nCancelled",
   "default": "Planned",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "search_index": 1,
   "description": "Planned → Ongoing → Executed, or Cancelled from either open state (source `MISSION_TRANSITIONS`). A Select and not a Workflow for the reason given on Operational Deployment."
  },
  {
   "fieldname": "sb_mission_area",
   "fieldtype": "Section Break",
   "label": "Area"
  },
  {
   "fieldname": "area",
   "fieldtype": "Data",
   "label": "Area",
   "length": 140
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text",
   "label": "Notes"
  },
  {
   "fieldname": "tab_provenance",
   "fieldtype": "Tab Break",
   "label": "Provenance & State"
  },
  {
   "fieldname": "sb_evidence",
   "fieldtype": "Section Break",
   "label": "Source & verification"
  },
  {
   "fieldname": "primary_source",
   "fieldtype": "Link",
   "label": "Primary source",
   "options": "Source",
   "description": "The source the record rests on. Additional claims from other sources are recorded in the Evidence table, one claim per row."
  },
  {
   "fieldname": "documentation_level",
   "fieldtype": "Link",
   "label": "Documentation level",
   "options": "Documentation Level"
  },
  {
   "fieldname": "authentication_level",
   "fieldtype": "Link",
   "label": "Authentication level",
   "options": "Authentication Level",
   "description": "How strongly the record's content is verified."
  },
  {
   "fieldname": "cb_provenance",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "workflow_state",
   "fieldtype": "Link",
   "label": "Record status",
   "options": "Workflow State",
   "default": "Draft",
   "read_only": 1,
   "in_standard_filter": 1,
   "search_index": 1,
   "no_copy": 1,
   "description": "Editorial state, driven by the SIRAJ Review workflow (Draft → In Review → Verified → Published, plus Needs Update / Disputed / Archived / Rejected)."
  },
  {
   "fieldname": "researcher_notes",
   "fieldtype": "Text",
   "label": "Researcher's notes",
   "permlevel": 1,
   "description": "Internal working notes. At permission level 1, so visible to reviewers and administrators only; discussion belongs in the document's comment thread instead."
  },
  {
   "fieldname": "sb_evidence_table",
   "fieldtype": "Section Break",
   "label": "Evidence (claims this record makes)"
  },
  {
   "fieldname": "evidence",
   "fieldtype": "Table",
   "label": "Evidence",
   "options": "Evidence",
   "no_copy": 1,
   "columns": 9,
   "description": "One row per claim: which source says what, where in the source, whether it supports or contradicts, and who verified it. Not copied with the record: a claim is evidence about one specific record."
  },
  {
   "fieldname": "sb_identifiers",
   "fieldtype": "Section Break",
   "label": "External identifiers"
  },
  {
   "fieldname": "external_identifiers",
   "fieldtype": "Table",
   "label": "External identifiers",
   "options": "External Identifier",
   "no_copy": 1,
   "columns": 8,
   "description": "VIAF, Wikidata, ORCID, library catalogue or legacy numbers, kept out of the record's own identifier. Never copied: an authority identifier belongs to exactly one record."
  },
  {
   "fieldname": "data_group",
   "fieldtype": "Link",
   "label": "Data Group",
   "options": "Data Group",
   "reqd": 1,
   "read_only": 0,
   "no_copy": 1,
   "search_index": 1,
   "in_standard_filter": 1
  }
 ],
