  {
   "fieldname": "image_url",
   "fieldtype": "Data",
   "label": "Image URL (external)",
   "options": "URL"
  },
  {
   "fieldname": "image_alt",
   "fieldtype": "Data",
   "label": "Image alt text",
   "length": 140
  },
  {
   "fieldname": "tab_timing",
   "fieldtype": "Tab Break",
   "label": "Timing & place"
  },
  {
   "fieldname": "sb_timing",
   "fieldtype": "Section Break",
   "label": "When"
  },
  {
   "fieldname": "start_date_as_stated",
   "fieldtype": "Data",
   "label": "Start (as stated)",
   "description": "A conference opens at 09:30; a death is known to the year. Both are legitimate and neither is promoted to the other.",
   "in_global_search": 1,
   "length": 32
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Datetime",
   "label": "Start (comparable)",
   "description": "Machine-comparable value derived from the 'as stated' value; used for filters, sorting and reports. Never more precise than what is stated.",
   "search_index": 1,
   "reqd": 0,
   "no_copy": 1,
   "read_only": 1,
   "hide_seconds": 1,
   "in_preview": 1,
   "allow_in_quick_entry": 1
  },
  {
   "fieldname": "start_date_precision",
   "fieldtype": "Select",
   "label": "Start precision",
   "options": "exact\nminute\nday\nmonth\nyear\ndecade\napproximate\nuncertain\nrange\nunknown",
   "default": "unknown",
   "no_copy": 1,
   "read_only": 1,
   "description": "How much of the date is actually known. 'approximate' keeps c. 1850; 'year' keeps 1850; 'decade' keeps '1850s'; 'minute' keeps a time of day."
  },
  {
   "fieldname": "end_date_as_stated",
   "fieldtype": "Data",
   "label": "End (as stated)",
   "description": "Exactly as the source gives it: 1950 \u00b7 1950-05 \u00b7 1950-05-12 \u00b7 1950-05-12T21:45 \u00b7 'c. 1850' \u00b7 '1850s' \u00b7 '1850?'. Authoritative value; the date field beside it is derived from it.",
   "in_global_search": 1,
   "length": 32
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Datetime",
   "label": "End (comparable)",
   "description": "Machine-comparable value derived from the 'as stated' value; used for filters, sorting and reports. Never more precise than what is stated.",
   "search_index": 1,
   "reqd": 0,
   "no_copy": 1,
   "read_only": 1,
   "hide_seconds": 1
  },
  {
   "fieldname": "end_date_precision",
   "fieldtype": "Select",
   "label": "End precision",
   "options": "exact\nminute\nday\nmonth\nyear\ndecade\napproximate\nuncertain\nrange\nunknown",
   "default": "unknown",
   "no_copy": 1,
   "read_only": 1,
   "description": "How much of the date is actually known. 'approximate' keeps c. 1850; 'year' keeps 1850; 'decade' keeps '1850s'; 'minute' keeps a time of day."
  },
  {
   "fieldname": "sb_place",
   "fieldtype": "Section Break",
   "label": "Where"
  },
  {
   "fieldname": "place",
   "fieldtype": "Link",
   "label": "Place",
   "options": "Place",
   "description": "The named place the event happened at.",
   "in_preview": 1
  },
  {
   "fieldname": "cb_place",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "place_as_stated",
   "fieldtype": "Data",
   "label": "Place (as stated)",
   "length": 140
  },
  {
   "fieldname": "sb_detail",
   "fieldtype": "Section Break",
   "label": "Description"
  },
  {
   "fieldname": "description",
   "fieldtype": "Text Editor",
   "label": "Description"
  },
  {
   "fieldname": "significance",
   "fieldtype": "Text Editor",
   "label": "Significance"
  },
  {
   "fieldname": "tab_evidence",
   "fieldtype": "Tab Break",
   "label": "Position & evidence"
  },
  {
   "fieldname": "sb_geo",
   "fieldtype": "Section Break",
   "label": "Position (this record's own)",
   "collapsible": 1,
   "collapsible_depends_on": "eval:doc.latitude && doc.longitude"
  },
  {
   "fieldname": "latitude",
   "fieldtype": "Float",
   "label": "Latitude",
   "precision": "6",
   "description": "This record's own latitude, independent of any linked place.",
   "in_standard_filter": 0
  },
  {
   "fieldname": "longitude",
   "fieldtype": "Float",
   "label": "Longitude",
   "precision": "6",
   "description": "This record's own longitude, independent of any linked place."
  },
  {
   "fieldname": "geo_point",
   "label": "Map (point)",
   "fieldtype": "Geolocation",
   "insert_after": "longitude",
   "description": "Select a point on the map. It is mirrored into the latitude and longitude fields and resolves the administrative hierarchy."
  },
  {
   "fieldname": "coordinate_origin_confirmed",
   "label": "0,0 is an actual point",
   "fieldtype": "Check",
   "default": "0",
   "insert_after": "longitude",
   "description": "Tick only when latitude 0 and longitude 0 are a deliberate real location; otherwise the zero pair is treated as unset."
  },
  {
   "fieldname": "geo_precision",
   "fieldtype": "Select",
   "label": "Coordinate precision",
   "options": "exact\napproximate\ncentroid\nuncertain",
   "description": "How close the point is to the true position.",
   "depends_on": "eval:doc.latitude && doc.longitude"
  },
  {
   "fieldname": "geocoding_method",
   "fieldtype": "Select",
   "label": "How the point was obtained",
   "options": "manual\nmap_pick\ncoordinate_entry\ngazetteer\nadministrative\ncity_centroid\ngeocoder\nhistorical_map\ninherited",
   "description": "A city centroid is not a street address; recording the method stops a centroid from being read as a verified location.",
   "depends_on": "eval:doc.latitude && doc.longitude"
  },
  {
   "fieldname": "geo_uncertainty_m",
   "fieldtype": "Float",
   "label": "Uncertainty radius (m)",
   "precision": "1",
   "description": "The radius the true position could lie within.",
   "depends_on": "eval:doc.latitude && doc.longitude"
  },
  {
   "fieldname": "geometry_source",
   "fieldtype": "Data",
   "label": "Point source",
   "length": 140,
   "description": "The map, survey or gazetteer the coordinates came from.",
   "depends_on": "eval:doc.latitude && doc.longitude"
  },
  {
   "fieldname": "country",
   "fieldtype": "Link",
   "label": "Country",
   "options": "Country"
  },
  {
   "fieldname": "governorate",
   "fieldtype": "Link",
   "label": "Governorate",
   "options": "Governorate"
  },
